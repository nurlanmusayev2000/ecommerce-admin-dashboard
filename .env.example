# Base URL for the mock API (json-server). Defaults to http://localhost:3001 if unset.
VITE_API_BASE_URL=http://localhost:3001

# Serve the API from MSW (Mock Service Worker) in the browser instead.
# Defaults to true in production builds without VITE_API_BASE_URL, false in dev.
# VITE_USE_MOCK_API=true
